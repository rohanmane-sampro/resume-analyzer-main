# ========================================
# GROQ API KEYS CONFIGURATION
# ========================================
# Add your Groq API keys below. You can add as many as you want (1-10 recommended).
# The system will randomly select one key for each request to distribute load.
#
# Benefits:
# - Avoid rate limits by distributing requests across multiple free-tier accounts
# - Increase reliability with automatic failover
# - Reduce costs by maximizing free tier usage
#
# Instructions:
# 1. Get your Groq API keys from: https://console.groq.com/keys
# 2. Add them below as GROQ_API_KEY_1, GROQ_API_KEY_2, etc.
# 3. You can add 1 to 10 keys (or more if needed)
# 4. Remove the # symbol to uncomment each line
# ========================================

# Primary key (always required)
GROQ_API_KEY_1=your_groq_api_key_here_1

# Additional keys (optional - add as many as you want)
# GROQ_API_KEY_2=your_groq_api_key_here_2
# GROQ_API_KEY_3=your_groq_api_key_here_3
# GROQ_API_KEY_4=your_groq_api_key_here_4
# GROQ_API_KEY_5=your_groq_api_key_here_5
# GROQ_API_KEY_6=your_groq_api_key_here_6
# GROQ_API_KEY_7=your_groq_api_key_here_7
# GROQ_API_KEY_8=your_groq_api_key_here_8
# GROQ_API_KEY_9=your_groq_api_key_here_9
# GROQ_API_KEY_10=your_groq_api_key_here_10

# ========================================
# OTHER ENVIRONMENT VARIABLES
# ========================================
# Add your other environment variables below
# (MongoDB URI, JWT Secret, etc.)
